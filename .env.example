# ---- MySQL (system of record: ExportJob / ExportTypes) ----
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_POOL_LIMIT=10

# ---- Athena (heavy export queries; iceberg_db) ----
# athena.service.js uses these dedicated keys, NOT the Lambda role.
AWS_ACCESS_KEY_ID_ATHENA=
AWS_SECRET_ACCESS_KEY_ATHENA=

# ---- S3 (final CSV bucket ncx-prod-exports) ----
# ncx-prod-exports lives in account 742019417498, but this Lambda runs in
# 003339248139, so the execution role can't write it. Supply the cross-account
# S3 creds here (custom names; AWS_ACCESS_KEY_ID is reserved in Lambda).
EXPORT_S3_ACCESS_KEY_ID=
EXPORT_S3_SECRET_ACCESS_KEY=

# ---- Redis (conversion export cache, via conversationWithTransaction) ----
REDIS_U=
REDIS_P=
REDIS_R=

# ---- Set automatically by Lambda; only needed for local runs ----
# AWS_REGION=ap-south-1

# ---- Populated by deploy.sh after the queue is created ----
# EXPORT_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<acct>/exports-queue-mumbai
